# Copia este archivo a .env.local y completá los valores reales.
# Nunca subas .env.local al repositorio.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# IA
GROQ_API_KEY=
GROQ_PDF_API_KEY=
GROQ_PDF_MODEL=llama-3.3-70b-versatile
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
# Opcional. Configuralo solo con un modelo vigente y habilitado en tu cuenta.
GROQ_FALLBACK_MODEL=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_SUMMARY_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_SUMMARY_MODEL=gemini-flash-lite-latest
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_URL=https://models.github.ai/inference/chat/completions
GITHUB_MODELS_SUMMARY_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_FALLBACK_MODEL=openai/gpt-4.1-mini
NVIDIA_API_KEY=
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_SUMMARY_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
AI_REQUEST_TIMEOUT_MS=60000

# Monitoreo (opcionales)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# ERROR_REPORT_URL=https://tu-endpoint-de-reporte
# AXIOM_INGEST_URL=
# AXIOM_INGEST_TOKEN=

# Marketing / terceros (opcionales)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (suscripciones)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TEST_MODE=false
MERCADOPAGO_TEST_PAYER_EMAIL=

# Internos (opcionales, solo cron/warmup)
CRON_SECRET=
INTERNAL_QUEUE_SECRET=
EXPLANATION_WARMUP_TOKEN=
